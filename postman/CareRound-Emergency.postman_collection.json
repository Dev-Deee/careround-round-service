              "host": [
                "{{notificationBaseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            },
            "description": "notification-service console (user.registered consumer) prints, per new account:\nNOTIFICATION [EMAIL -> <email>]: Welcome ... Activate your account: <link>\nFor the nurse and doctor:\n1. Set nursePassword and doctorPassword in this environment to a password (>= 8 chars).\n2. Open the link in a browser, enter that password twice, submit -> 'Your account is active'.\nIf the nurse got a resend (folder 01), use the NEWEST link ('activation link has been renewed').\nLinks expire after 1h (30m for a resend); re-run the resend request for a fresh one.\nDB check:\ndocker exec -it careround-postgres psql -U postgres -d careround_notification_db -c \"SELECT idempotency_key, channel, recipient, event_type, status, sent_at FROM sent_notifications ORDER BY sent_at DESC LIMIT 5;\"\npm.test('Passwords set in the environment for the next logins', function () {\npm.expect(pm.environment.get('nursePassword'), 'nursePassword').to.be.a('string').and.not.empty; pm.expect(pm.environment.get('doctorPassword'), 'doctorPassword').to.be.a('string').and.not.empty;\n});"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// notification-service console (user.registered consumer) prints, per new account:",
                  "//   NOTIFICATION [EMAIL -> <email>]: Welcome ... Activate your account: <link>",
                  "// For the nurse and doctor:",
                  "//   1. Set nursePassword and doctorPassword in this environment to a password (>= 8 chars).",
                  "//   2. Open the link in a browser, enter that password twice, submit -> 'Your account is active'.",
                  "// If the nurse got a resend (folder 01), use the NEWEST link ('activation link has been renewed').",
                  "// Links expire after 1h (30m for a resend); re-run the resend request for a fresh one.",
                  "// DB check:",
                  "//   docker exec -it careround-postgres psql -U postgres -d careround_notification_db -c \"SELECT idempotency_key, channel, recipient, event_type, status, sent_at FROM sent_notifications ORDER BY sent_at DESC LIMIT 5;\"",
                  "pm.test('Passwords set in the environment for the next logins', function () {",
                  "    pm.expect(pm.environment.get('nursePassword'), 'nursePassword').to.be.a('string').and.not.empty; pm.expect(pm.environment.get('doctorPassword'), 'doctorPassword').to.be.a('string').and.not.empty;",
                  "});"
                ]
