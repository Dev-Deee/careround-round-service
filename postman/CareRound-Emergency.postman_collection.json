              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Ward {{runId}}\",\n  \"capacity\": 20\n}"
            },
            "description": "Patient admission and round creation verify the ward with ward-service (404 for an unknown ward), so each run creates a real ward and uses its publicId."
          },
          "response": [],
